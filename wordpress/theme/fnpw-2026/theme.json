  "styles": {
    "color": {
      "background": "var(--wp--preset--color--cream)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "17px",
      "lineHeight": "1.65"
    },
    "elements": {
      "link": {
        "color": {
          "text": "inherit"
        },
        "typography": {
          "textDecoration": "none"
        }
      },
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "600",
          "lineHeight": "1.05",
          "letterSpacing": "-.03em",
          "fontSize": "clamp(2rem,4.4vw,3.6rem)"
        },
        "color": {
          "text": "var(--wp--preset--color--eucalyptus-deep)"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "600",
          "lineHeight": "1.08",
          "letterSpacing": "-.02em",
          "fontSize": "clamp(1.6rem,3vw,2.4rem)"
        },
        "color": {
          "text": "var(--wp--preset--color--eucalyptus-deep)"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "600",
          "lineHeight": "1.08",
          "letterSpacing": "-.022em",
          "fontSize": "clamp(1.2rem,1.8vw,1.5rem)"
        },
        "color": {
          "text": "var(--wp--preset--color--eucalyptus-deep)"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "600",
          "lineHeight": "1.08",
          "letterSpacing": "-.022em",
          "fontSize": "clamp(1rem,1.3vw,1.15rem)"
        },
        "color": {
          "text": "var(--wp--preset--color--eucalyptus-deep)"
        }
      },
      "h5": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "600",
          "lineHeight": "1.08",
          "letterSpacing": "-.022em"
        },
        "color": {
          "text": "var(--wp--preset--color--eucalyptus-deep)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--eucalyptus-deep)",
          "text": "var(--wp--preset--color--cream)"
        },
        "border": {
          "radius": "0",
          "width": "1.5px",
          "style": "solid",
          "color": "var(--wp--preset--color--eucalyptus-deep)"
        },
        "spacing": {
          "padding": {
            "top": ".85em",
            "bottom": ".85em",
            "left": "1.6em",
            "right": "1.6em"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontWeight": "500",
          "fontSize": ".86rem",
          "letterSpacing": ".01em",
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--eucalyptus)",
            "text": "var(--wp--preset--color--cream)"
          },
          "border": {
            "color": "var(--wp--preset--color--eucalyptus)"
          }
        }
      }
    }
